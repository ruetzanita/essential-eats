# Essential Eats Logic Worker - Environment Configuration Template
# Duplicate this file as .dev.vars for local development or set via Wrangler secrets:
#   npx wrangler secret put GEMINI_API_KEY

# Google Gemini API Key (Required for AI recipe parsing and suggestion)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (Optional, defaults to gemini-3.8-flash in wrangler.jsonc)
GEMINI_MODEL=gemini-3.8-flash
