{
  "manifest_version": 3,
  "name": "Essential Eats • Recipe Clipper",
  "version": "1.0.0",
  "description": "Clip clean, ad-free recipes from any food blog or website directly into your Essential Eats favorites.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Clip Recipe to Essential Eats",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://essentialeats.ruetzanita.com/*",
        "http://localhost:*/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
